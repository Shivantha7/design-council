  "export_commit": "5e047d357afc3908278585f4d0206fcc5025158c",
  "findings": [
    {
      "id": "H1",
      "status": "pre-registered",
      "text": "10 of 68 runs fell below 1.0 (9 council, 1 baseline), so Branch B applies. In an exploratory classification, 8 of these are naming mismatches under exact matching, 1 substantive and 1 unclear.",
      "title": "Conformance is a floor, not a discriminator"
    },
    {
      "id": "H2",
      "status": "pre-registered",
      "text": "Council mean depth exceeded the single agentic AI baseline by at least the 0.2 SESOI on 4 of 7 workflows (threshold 4), so H2 is supported. 2 of those gaps are exactly 0.2 (P2P-TWM-01, FPA-ABB-01), decided by exact-fraction comparison.",
      "title": "Agentic AI deliberation transforms more deeply"
    },
    {
      "id": "H3",
      "status": "pre-registered",
      "text": "4 of 14 cells stabilised against a threshold of 8, so the stabilisation claim is not supported. The stopping rule is reported as an efficiency rule, not as evidence of convergence.",
      "title": "Depth does not stabilise by run 4 or 5"
    },
    {
      "id": "ELIM",
      "status": "pre-registered",
      "text": "Neither condition eliminated any step. Absorbed dispositions: council 5, baseline 17. The council restructures (170 vs 95) rather than removing steps.",
      "title": "No step is eliminated; the council restructures"
    },
    {
      "id": "GOV",
      "status": "pre-registered coding",
      "text": "78 council-attributed controls (present in ≥ 60% of council runs and in no baseline run). The agentic architect role introduced the most (28 as primary role).",
      "title": "Deliberation adds governance controls"
    },
    {
      "id": "PROD",
      "status": "exploratory",
      "text": "Pooled structural productivity potential (PI) is 0.199 under the primary classification and 0.041 when only agentic AI (not deterministic automation) counts. Transactional workflows 0.374, judgment-dense 0.023. These are estimates under stated assumptions, not measured outcomes.",
      "title": "Productivity potential is concentrated in transactional work"
    }
  ],
