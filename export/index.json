{
  "export_commit": "dfee684726198392ab94940ac0b5f6bba36adb49",
  "findings": [
    {
      "id": "F1",
      "status": "pre-registered",
      "text": "The council's mean depth was higher than the budget-matched single agent's on 7 of 7 workflows. The gap reached the 0.2 SESOI on 4 of 7 (threshold 4), so H2 is supported at the threshold. Sign test across workflows: p = 0.008 (one-sided, exploratory).",
      "title": "Agentic deliberation transforms more deeply"
    },
    {
      "id": "F2",
      "status": "exploratory",
      "text": "Mean depth gap 0.257 on judgment-dense workflows against 0.119 on transactional ones.",
      "title": "Deliberation matters most where judgment matters most"
    },
    {
      "id": "F3",
      "status": "pre-registered",
      "text": "0 eliminations in the council and 0 in the budget-matched single agent, although 16 of 57 steps were open to elimination by design.",
      "title": "Agentic AI transforms the path, not the task list"
    },
    {
      "id": "F4",
      "status": "pre-registered counts",
      "text": "Council vs budget-matched single agent: restructured 170 vs 95, absorbed 5 vs 17, merged 55 vs 81. Run-to-run consistency 0.789 vs 0.702.",
      "title": "Single agents compress; multi-agent systems re-architect"
    },
    {
      "id": "F5",
      "status": "exploratory",
      "text": "About 37% of human effort is removed on transactional workflows and about 2% on judgment-dense ones, where human checkpoints rise instead (human-in-the-loop checkpoints across the three judgment-dense workflows: 4 in the originals, 9.0 in the council designs, mean per run). Pooled: 20%.",
      "title": "Two kinds of value"
    },
    {
      "id": "F6",
      "status": "pre-registered coding",
      "text": "78 council-attributed controls in 7 of 7 workflows (57 at 75%), from 277 distinct controls (307 candidates). Agentic Architect 28, Emerging-Economy Constraint 21, Maximalist 0 (primary role).",
      "title": "Deliberation adds governance"
    }
  ],
  "headline": {
    "council_attributed_controls": 78,
