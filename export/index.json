  "limits": [
    {
      "id": "H1",
      "text": "10 of 68 runs fell below 1.0 conformance, 9 of them council runs. 8 of the 9 council failures are naming differences (exploratory classification)."
    },
    {
      "id": "H3",
      "text": "H3 is not supported: 4 of 14 cells stabilised."
    },
    {
      "id": "COST",
      "text": "The council costs about 19× the budget-matched single agent ($1.42 vs $0.07 per run)."
    },
    {
      "id": "MODEL",
      "text": "One model family was used for both conditions."
    },
    {
      "id": "MATCH",
      "text": "The baseline is budget-matched, not compute-matched."
    }
  ],
